{
  "name": "meeting-bot",
  "version": "1.2.35",
  "description": "Records Google Meet lectures and publishes them to YouTube playlists",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "start": "nodemon --legacy-watch src/index.ts",
    "local": "node scripts/launch.js",
    "dev": "docker compose up --build",
    "stop": "docker compose down",
    "build": "tsc",
    "lint": "eslint \"*/**/*.{js,ts}\" --quiet --fix",
    "dev:mock": "node scripts/dev/dev-server.js",
    "test:e2e": "node scripts/dev/e2e.js",
    "reset-password": "ts-node src/cli/reset-password.ts"
  },
  "keywords": [],
  "author": "screenappai",
  "devDependencies": {
    "@playwright/test": "^1.45.3",
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^5.55.0",
    "@typescript-eslint/parser": "^5.55.0",
    "eslint": "^8.36.0",
    "nodemon": "^3.1.4"
  },
  "dependencies": {
    "@aws-sdk/client-ecs": "^3.876.0",
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/lib-storage": "^3.876.0",
    "@aws-sdk/s3-request-presigner": "^3.876.0",
    "@azure/identity": "^4.13.0",
    "@azure/storage-blob": "^12.29.1",
    "@google-cloud/storage": "^7.16.0",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fs-extra": "^11.2.0",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.46",
    "playwright": "^1.45.3",
    "playwright-extra": "^4.3.6",
    "playwright-extra-plugin-stealth": "^0.0.1",
    "prom-client": "^15.1.3",
    "puppeteer": "^22.15.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "redis": "^5.8.1",
    "serialize-error": "^12.0.0",
    "ts-node": "^10.9.2",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "winston-transport": "^4.9.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
