# Copy to deploy/.env and fill in. Only DOMAIN and ADMIN_EMAIL are required to start.

# The address of the dashboard, without https:// (its DNS A record must point at this server)
DOMAIN=recorder.example.com

# The admin account created on the first start. Leave ADMIN_PASSWORD empty to get a random one
# printed in the logs (docker compose logs app); you choose your own at the first sign-in either way.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# YouTube: from the Google Cloud OAuth client (docs/SETUP.md, step 5). Usually entered in the
# dashboard instead (Settings -> YouTube); values here take precedence.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# unlisted (default), private or public
YOUTUBE_PRIVACY=unlisted

# Time zone used for the dates and times in video titles and descriptions
TZ=Asia/Kolkata

# Name the recorder shows in the meeting
BOT_NAME=Lecture Recorder

# How many lectures can be recorded at the same time. 3 needs roughly 2 CPU cores and 6 GB RAM.
MAX_CONCURRENT_BOTS=3

# The recorder leaves when it has been alone this long, or after this many hours at most
LECTURE_ALONE_EXIT_MINUTES=10
LECTURE_INITIAL_ALONE_MINUTES=20
LECTURE_MAX_HOURS=5
# How long it waits to be admitted before giving up
JOIN_WAIT_TIME_MINUTES=10

# Recording quality: 800 kbps VP8 at 15 fps is about 0.4 GB per hour
RECORDING_VIDEO_KBPS=800
RECORDING_AUDIO_KBPS=64
RECORDING_CODEC=vp8
RECORDING_FPS=15

# Server copies are deleted this many days after they are safely on YouTube (sooner if the
# disk has less than LOW_DISK_GB free). Recordings not yet on YouTube are never deleted.
LOCAL_RETENTION_DAYS=14
LOW_DISK_GB=15
# Recordings shorter than this are not sent to YouTube (accidental starts)
MIN_UPLOAD_SECONDS=60

# Permanent backup in Amazon S3 of every recording, plus a daily database backup (off when empty).
# On AWS the CloudFormation template fills these in and gives the server access through its IAM role.
# Elsewhere, also set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY for an IAM user limited to the bucket.
ARCHIVE_S3_BUCKET=
AWS_REGION=ap-south-1
ARCHIVE_S3_PREFIX=
ARCHIVE_S3_STORAGE_CLASS=STANDARD_IA
DB_BACKUP_HOUR=3

# Where the recorder browsers run. "inprocess" (default): on this server, up to MAX_CONCURRENT_BOTS.
# "ecs": one AWS Fargate task per lecture, started on demand (set up by deploy/aws/lecture-recorder.yaml,
# which also fills in the ECS_* values). Needs ARCHIVE_S3_BUCKET: recorders upload to S3 every 30 s.
RECORDER_MODE=inprocess
# ECS_CLUSTER=
# ECS_TASK_DEFINITION=
# ECS_SUBNETS=subnet-aaa,subnet-bbb
# ECS_SECURITY_GROUPS=sg-ccc
# ECS_USE_SPOT=false
# ECR_REPOSITORY_URI=
# A lost recorder is replaced after this many seconds without a report
# RECORDER_HEARTBEAT_TIMEOUT_SECONDS=60
